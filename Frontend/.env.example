# MessLedger Frontend Environment Configuration
# API Base URL (leave empty or set to your backend server e.g. http://localhost:5000/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Client ID (Public client identifier, NEVER put client secret here)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Razorpay Key ID (Public key identifier, NEVER put key secret here)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Mock Mode: Set to 'true' to run frontend with complete offline mock data & simulated payment flows
VITE_USE_MOCK=true
