{
  "info": {
    "name": "MessLedger API Collection",
    "description": "Comprehensive Postman collection for testing MessLedger backend routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Root Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "2. Hostels",
      "item": [
        {
          "name": "Get All Hostels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hostels",
              "host": ["{{baseUrl}}"],
              "path": ["hostels"]
            }
          }
        },
        {
          "name": "Get Hostel by Name (LBBH)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/hostels/LBBH",
              "host": ["{{baseUrl}}"],
              "path": ["hostels", "LBBH"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Boarders Roster",
      "item": [
        {
          "name": "Get All Boarders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/boarders",
              "host": ["{{baseUrl}}"],
              "path": ["boarders"]
            }
          }
        },
        {
          "name": "Verify Student Eligibility (Pre-Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rollNo\": \"24CS099\",\n  \"email\": \"arunav.cs24@tezu.ac.in\",\n  \"hostel\": \"LBBH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/boarders/verify",
              "host": ["{{baseUrl}}"],
              "path": ["boarders", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Authentication",
      "item": [
        {
          "name": "Student Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "    console.log('Saved authToken:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul.cs24@tezu.ac.in\",\n  \"password\": \"Password123!\",\n  \"rollNo\": \"2024CS01\",\n  \"hostel\": \"LBBH\",\n  \"room\": \"101\",\n  \"phone\": \"+91 94350 99887\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "    console.log('Updated authToken:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul.cs24@tezu.ac.in\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Admin Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Warden\",\n  \"email\": \"admin.lbbh@hostel.edu\",\n  \"password\": \"AdminSecure2026!\",\n  \"designation\": \"Hostel Warden\",\n  \"hostel\": \"LBBH\",\n  \"phone\": \"+91 94350 11223\",\n  \"inviteToken\": \"MESS_ADMIN_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin-register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin-register"]
            }
          }
        },
        {
          "name": "Get Authenticated User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "5. User Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"room\": \"102\",\n  \"phone\": \"+91 94350 88776\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            }
          }
        },
        {
          "name": "Delete User Account (Self)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            }
          }
        },
        {
          "name": "Delete User by ID (Admin/Warden)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["user", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "usr_example_id",
                  "description": "ID of user to delete"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Mess Bills",
      "item": [
        {
          "name": "Get Current Student Bill",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bills/current",
              "host": ["{{baseUrl}}"],
              "path": ["bills", "current"]
            }
          }
        },
        {
          "name": "Get Bills History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bills",
              "host": ["{{baseUrl}}"],
              "path": ["bills"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Payments & Transactions",
      "item": [
        {
          "name": "Create Payment Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2450,\n  \"billId\": \"current_bill\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/create-order",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "create-order"]
            }
          }
        },
        {
          "name": "Verify / Settle Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpay_order_id\": \"order_test_12345\",\n  \"razorpay_payment_id\": \"pay_test_987654\",\n  \"amount\": 2450,\n  \"method\": \"UPI\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/verify",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "verify"]
            }
          }
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Notifications",
      "item": [
        {
          "name": "Get User Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/mark-all-read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "mark-all-read"]
            }
          }
        }
      ]
    }
  ]
}
